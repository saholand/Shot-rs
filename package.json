{
  "name": "shotirs",
  "version": "1.0.0",
  "description": "Fast screenshot and screen recording tool — region capture, screen recording, OCR, annotation",
  "author": {
    "name": "Shotırs",
    "email": "alihanaydin.media@gmail.com"
  },
  "productName": "Shotırs",
  "homepage": "https://github.com/saholand/shotirs",
  "repository": {
    "type": "git",
    "url": "https://github.com/saholand/shotirs.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "dist:nsis": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.shotirs.app",
    "productName": "Shotırs",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "resources/tessdata/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/uiohook-napi/**",
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Shotırs",
      "fileDescription": "Shotırs — Screenshot & Screen Recording",
      "legalCopyright": "Copyright © 2026 Shotırs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "saholand",
        "repo": "shotirs"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shotırs"
    },
    "portable": {
      "artifactName": "Shotirs-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
